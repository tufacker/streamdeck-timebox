      "UUID": "io.github.tufacker.timebox.scrub-dial",
      "Icon": "imgs/actions/action",
      "Tooltip": "Rotate to scrub the timer. Press to reset.",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/action"
        }
      ],
      "Encoder": {
        "layout": "layouts/dial.json",
        "StackColor": "#A8F09B",
        "TriggerDescription": {
          "Rotate": "Scrub timer",
          "Push": "Reset"
        }
