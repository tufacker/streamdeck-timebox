{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Timebox",
  "Version": "2.1.0.0",
  "Author": "tufacker",
  "Description": "ADHD-style visual timeboxing timer for Stream Deck + and Stream Deck MK.2.",
  "URL": "https://github.com/tufacker/streamdeck-timebox",
  "UUID": "io.github.tufacker.timebox",
  "Category": "Timebox",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "ui/settings.html",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Profiles": [
    {
      "Name": "Timebox",
      "DeviceType": 7,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": false,
      "AutoInstall": true
    },
    {
      "Name": "timebox-mk2",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": false,
      "AutoInstall": true
    }
  ],
